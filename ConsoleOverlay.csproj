<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>ConsoleOverlay</AssemblyName>
    <RootNamespace>ConsoleOverlay</RootNamespace>
    <Version>1.3.0</Version>
    <Authors>galcn10</Authors>
    <Copyright>Copyright (c) 2026 galcn10</Copyright>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.15.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Management" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="mpv\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fonts\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
