<UserControl x:Class="ConsoleOverlay.ConsoleOverlaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,6,20,20" MaxWidth="520" HorizontalAlignment="Left">

            <TextBlock Text="General" FontWeight="Bold" FontSize="14" Margin="0,8,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,7"
                        ToolTip="Para corregir o añadir un idioma, crea un archivo lang\xx.txt en la carpeta de datos del plugin (una línea por frase: original, tabulador, traducción).">
                <TextBlock Text="Idioma:" VerticalAlignment="Center" Width="190" />
                <ComboBox Width="220" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name"
                          SelectedValuePath="Code" SelectedValue="{Binding Language}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,7"
                        ToolTip="Tema de Playnite: el fondo toma los colores del tema (si no los encuentra, usa los de la carátula). Color del juego: los de la carátula. Neutro: sin color.">
                <TextBlock Text="Colores del menú:" VerticalAlignment="Center" Width="190" />
                <ComboBox Width="220" ItemsSource="{Binding MenuColorOptions}" DisplayMemberPath="Name"
                          SelectedValuePath="Code" SelectedValue="{Binding MenuColors}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Iconos de los botones:" VerticalAlignment="Center" Width="190" />
                <ComboBox Width="140" ItemsSource="{Binding ButtonStyleOptions}" SelectedItem="{Binding ButtonStyle}" />
            </StackPanel>
            <CheckBox Margin="0,0,0,7" Content="Confirmar acciones importantes" IsChecked="{Binding ConfirmActions}"
                      ToolTip="Pide confirmación al finalizar, suspender, reiniciar o apagar." />
            <CheckBox Margin="0,0,0,7" Content="Silenciar el juego en pausa" IsChecked="{Binding MuteGame}" />
            <CheckBox Margin="0,0,0,7" Content="Batería del mando" IsChecked="{Binding ShowBattery}" />
            <CheckBox Margin="0,0,0,7" Content="Miniatura del juego" IsChecked="{Binding ShowLivePreview}"
                      ToolTip="En directo si el juego no se pausa; si está pausado, el último fotograma. Algunos juegos en pantalla completa exclusiva pueden verse en negro." />

            <TextBlock Text="Abrir el menú" FontWeight="Bold" FontSize="14" Margin="0,18,0,6" />
            <CheckBox Margin="0,0,0,7" Content="Botón Guía del mando (PS / Xbox)" IsChecked="{Binding UseGuideButton}"
                      ToolTip="Pulsación corta: abrir el menú o volver al juego. Pulsación larga: menú de energía. Si otro programa (Steam, GameHQ...) usa ese botón, desactiva allí su acción." />
            <CheckBox Margin="0,0,0,7" Content="Select + Start (mantener 1 s)" IsChecked="{Binding UseChordButton}"
                      ToolTip="Alternativa para mandos sin botón Guía o si otro programa lo ocupa." />

            <Expander Margin="0,10,0,0" Header="Atajos de teclado">
                <StackPanel Margin="18,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                ToolTip="Modificadores de los dos atajos. Asigna después estas combinaciones a un botón del mando con JoyToKey.">
                        <TextBlock Text="Modificadores:" VerticalAlignment="Center" Width="172" />
                        <CheckBox Content="Ctrl" IsChecked="{Binding UseCtrl}" Margin="0,0,14,0" />
                        <CheckBox Content="Alt" IsChecked="{Binding UseAlt}" Margin="0,0,14,0" />
                        <CheckBox Content="Mayús" IsChecked="{Binding UseShift}" Margin="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                ToolTip="Pulsación corta: abrir el menú del juego, o volver al juego. Pulsación larga: menú de energía.">
                        <TextBlock Text="Tecla del menú:" VerticalAlignment="Center" Width="172" />
                        <ComboBox Width="80" ItemsSource="{Binding KeyOptions}" SelectedItem="{Binding MenuKey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                ToolTip="Cierra el juego directamente, sin confirmación.">
                        <TextBlock Text="Tecla de finalizar juego:" VerticalAlignment="Center" Width="172" />
                        <ComboBox Width="80" ItemsSource="{Binding KeyOptions}" SelectedItem="{Binding EndKey}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Margin="0,10,0,0" Header="Capturas y clips">
                <StackPanel Margin="18,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                ToolTip="Rellena los atajos habituales del programa; corrígelos si los has cambiado en él. Los que dejes vacíos no aparecen en el menú. Formato: Ctrl+Shift+S, Alt+F1, Win+Alt+PrtScn...">
                        <TextBlock Text="Programa:" VerticalAlignment="Center" Width="172" />
                        <ComboBox Width="160" ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding CapturePreset}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Capturar pantalla:" VerticalAlignment="Center" Width="172" />
                        <TextBox Width="160" Text="{Binding ScreenshotKeys, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Guardar clip:" VerticalAlignment="Center" Width="172" />
                        <TextBox Width="160" Text="{Binding ClipKeys, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Ver capturas:" VerticalAlignment="Center" Width="172" />
                        <TextBox Width="160" Text="{Binding GalleryKeys, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                ToolTip="Opcional, separadas por punto y coma. El menú ya busca en las carpetas habituales (GameHQ, Captures, Screenshots, NVIDIA...).">
                        <TextBlock Text="Carpetas extra:" VerticalAlignment="Center" Width="172" />
                        <TextBox Width="300" Text="{Binding CaptureFolders, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Margin="0,10,0,0" Header="Juegos">
                <StackPanel Margin="18,8,0,0">
                    <CheckBox Margin="0,0,0,7" Content="No pausar juegos con anticheat" IsChecked="{Binding NoPauseAntiCheat}"
                              ToolTip="EasyAntiCheat, BattlEye, Vanguard, ACE... y los marcados con la etiqueta «No pausar»: el menú se abre con el juego en marcha para no perder la partida online." />
                    <CheckBox Margin="0,0,0,7" Content="Quitar «Ejecutar como administrador» al iniciar" IsChecked="{Binding AutoRemoveAdmin}"
                              ToolTip="Quita esa marca de compatibilidad de los juegos antes de iniciarlos, para poder pausarlos sin reiniciar." />
                    <CheckBox Margin="0,0,0,7" Content="Menú de energía fuera de un juego" IsChecked="{Binding PowerMenuOutsideGame}"
                              ToolTip="Abre también el menú de energía con el botón o el atajo cuando no hay ningún juego en marcha." />
                    <CheckBox Margin="0,0,0,7" Content="Mantener el juego delante" IsChecked="{Binding KeepGameInFront}"
                              ToolTip="Si Playnite aparece solo durante el juego (p. ej. al cerrar el overlay de capturas), se minimiza y el juego vuelve al frente." />
                    <StackPanel Margin="0,4,0,0"
                                ToolTip="Windows no deja a un Playnite normal pausar ni cerrar esos juegos. La solución completa: ejecutar Playnite como administrador, o quitar «Ejecutar como administrador» en las propiedades del juego.">
                        <TextBlock Text="Juegos que se ejecutan como administrador:" Margin="0,0,0,4" />
                        <ComboBox Width="320" HorizontalAlignment="Left" SelectedIndex="{Binding ElevatedMode}">
                            <ComboBoxItem Content="Abrir el menú encima, sin pausar el juego" />
                            <ComboBoxItem Content="Solo avisar en pantalla (no abrir el menú)" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Margin="0,10,0,0" Header="Avanzado">
                <StackPanel Margin="18,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Pulsación larga (ms):" VerticalAlignment="Center" Width="172" />
                        <TextBox Width="80" Text="{Binding LongPressMs, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                ToolTip="Se ejecutan con cmd. Puedes sustituir el de apagar por un script propio.">
                        <TextBlock Text="Reiniciar:" VerticalAlignment="Center" Width="172" />
                        <TextBox Width="260" Text="{Binding RestartCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                ToolTip="Se ejecutan con cmd. Puedes sustituir el de apagar por un script propio.">
                        <TextBlock Text="Apagar:" VerticalAlignment="Center" Width="172" />
                        <TextBox Width="260" Text="{Binding ShutdownCommand}" />
                    </StackPanel>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
