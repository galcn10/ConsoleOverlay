<UserControl x:Class="ConsoleOverlay.ConsoleOverlaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Texto de ayuda bajo cada ajuste -->
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.82" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Style>
        <!-- Interruptor: etiqueta a la izquierda, pastilla a la derecha -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" TextElement.FontSize="14" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Border x:Name="track" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Background="#667A8194" VerticalAlignment="Center">
                                <Ellipse x:Name="thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#3F8CFF" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Pestañas arriba, con subrayado en la activa -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Padding="14,8" Margin="0,0,2,0" BorderThickness="0,0,0,3" BorderBrush="Transparent" Background="Transparent" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="14" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22808080" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#3F8CFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <TabPanel x:Name="HeaderPanel" DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,0" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </ScrollViewer>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="16,8,16,0">
        <Grid DockPanel.Dock="Top" Margin="4,4,0,8" MaxWidth="640" HorizontalAlignment="Left" Width="640">
            <TextBox x:Name="SearchBox" Padding="8,6" FontSize="14" TextChanged="SearchBox_TextChanged" />
            <TextBlock x:Name="SearchHint" Text="Buscar ajustes…" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.5" IsHitTestVisible="False" />
        </Grid>
        <TextBlock x:Name="NoResults" DockPanel.Dock="Top" Text="No hay ajustes que coincidan." Margin="8,12,0,0" Opacity="0.7" Visibility="Collapsed" />
        <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent">
        <TabItem Header="General">
            <StackPanel Margin="4,18,8,20" MaxWidth="640" HorizontalAlignment="Left">
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock x:Name="ThemeProbe" Text="Idioma:" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Help}" Text="Para corregir o añadir un idioma, crea un archivo lang\xx.txt en la carpeta de datos del plugin (una línea por frase: original, tabulador, traducción)." />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <ComboBox Width="220" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Language}" />
                </ContentControl>
            </Grid>
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Colores del menú:" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Help}" Text="Tema de Playnite: el fondo toma los colores del tema (si no los encuentra, usa los de la carátula). Color del juego: los de la carátula. Neutro: sin color." />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <ComboBox Width="220" ItemsSource="{Binding MenuColorOptions}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding MenuColors}" />
                </ContentControl>
            </Grid>
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Tipografía del menú:" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Help}" Text="Tema de Playnite usa la fuente de tu tema. Inter y Nunito vienen incluidas con el plugin." />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <ComboBox Width="220" ItemsSource="{Binding MenuFontOptions}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding MenuFont}" />
                </ContentControl>
            </Grid>
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Iconos de los botones:" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <ComboBox Width="140" ItemsSource="{Binding ButtonStyleOptions}" SelectedItem="{Binding ButtonStyle}" />
                </ContentControl>
            </Grid>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Confirmar acciones importantes" IsChecked="{Binding ConfirmActions}" />
                <TextBlock Style="{StaticResource Help}" Text="Pide confirmación al finalizar, suspender, reiniciar o apagar." />
            </StackPanel>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Silenciar el juego en pausa" IsChecked="{Binding MuteGame}" />
                <TextBlock Style="{StaticResource Help}" Text="El audio del juego se silencia mientras el menú está abierto." />
            </StackPanel>
            </StackPanel>
        </TabItem>
        <TabItem Header="Menú">
            <StackPanel Margin="4,18,8,20" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Batería del mando" IsChecked="{Binding ShowBattery}" />
                <TextBlock Style="{StaticResource Help}" Text="Muestra el nivel de batería de los mandos conectados en la cabecera del menú." />
            </StackPanel>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Miniatura del juego" IsChecked="{Binding ShowLivePreview}" />
                <TextBlock Style="{StaticResource Help}" Text="En directo si el juego no se pausa; si está pausado, el último fotograma. Algunos juegos en pantalla completa exclusiva pueden verse en negro." />
            </StackPanel>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Animaciones del menú" IsChecked="{Binding AnimationsEnabled}" />
                <TextBlock Style="{StaticResource Help}" Text="Fundidos, filas que entran en cadena y brillo al cambiar de fila. Desactívalas si el equipo va justo." />
            </StackPanel>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Sonidos del menú" IsChecked="{Binding SoundsEnabled}" />
                <TextBlock Style="{StaticResource Help}" Text="Sonidos suaves al mover y elegir opciones." />
            </StackPanel>
            <Grid Tag="row" Margin="22,0,0,16" IsEnabled="{Binding SoundsEnabled}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Volumen de los sonidos:" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <Slider Width="200" Minimum="0" Maximum="100" Value="{Binding SoundVolume}" />
                </ContentControl>
            </Grid>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Vibración del mando al abrir el menú" IsChecked="{Binding VibrationEnabled}" />
                <TextBlock Style="{StaticResource Help}" Text="Una vibración corta confirma que el menú se ha abierto." />
            </StackPanel>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Música en el menú" IsChecked="{Binding ShowMusic}" />
                <TextBlock Style="{StaticResource Help}" Text="Música en el menú: muestra lo que suena (Spotify, SimpMusic, YouTube Music en el navegador...) y permite pausar y cambiar de canción con el mando. Usa el control de medios de Windows; no necesita cuenta ni conexión." />
            </StackPanel>
            <Grid Tag="row" Margin="22,0,0,16" IsEnabled="{Binding ShowMusic}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Reproductor preferido:" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Help}" Text="Reproductor preferido: escribe parte de su nombre (por ejemplo Spotify o SimpMusic). Si hay varios reproductores a la vez, se usa este. Vacío = el que esté sonando." />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <TextBox Width="180" Text="{Binding MusicPlayer, UpdateSourceTrigger=PropertyChanged}" />
                </ContentControl>
            </Grid>
            <Grid Tag="row" Margin="22,0,0,16" IsEnabled="{Binding ShowMusic}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Reproductores para abrir:" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Help}" Text="Reproductores para abrir: uno por línea, con el formato Nombre|ruta (o un enlace como spotify:). Se ofrecen en el menú cuando no suena nada. Vacío = Spotify si está instalado." />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <TextBox Width="220" Height="60" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" Text="{Binding MusicApps, UpdateSourceTrigger=PropertyChanged}" />
                </ContentControl>
            </Grid>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Cambiar de juego desde el menú" IsChecked="{Binding ShowRecents}" />
                <TextBlock Style="{StaticResource Help}" Text="Panel «Cambiar a»: al seleccionar «Finalizar juego», muestra los 3 últimos juegos para cambiar a uno de ellos." />
            </StackPanel>
            </StackPanel>
        </TabItem>
        <TabItem Header="Abrir el menú">
            <StackPanel Margin="4,18,8,20" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Botón Guía del mando (PS / Xbox)" IsChecked="{Binding UseGuideButton}" />
                <TextBlock Style="{StaticResource Help}" Text="Pulsación corta: abrir el menú o volver al juego. Pulsación larga: menú de energía. Si otro programa (Steam, GameHQ...) usa ese botón, desactiva allí su acción." />
            </StackPanel>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Select + Start (mantener 1 s)" IsChecked="{Binding UseChordButton}" />
                <TextBlock Style="{StaticResource Help}" Text="Alternativa para mandos sin botón Guía o si otro programa lo ocupa." />
            </StackPanel>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Cerrar el juego: Start + LB (mantener 1,5 s)" IsChecked="{Binding UseCloseChord}" />
                <TextBlock Style="{StaticResource Help}" Text="Cierra el juego directamente, sin confirmación. Vibra al cerrar. Solo funciona con el menú cerrado." />
            </StackPanel>
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Modificadores:" FontSize="14" />
                    <TextBlock Style="{StaticResource Help}" Text="Modificadores de los dos atajos. Asigna después estas combinaciones a un botón del mando con JoyToKey." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <CheckBox Content="Ctrl" IsChecked="{Binding UseCtrl}" Margin="0,0,14,0" />
                    <CheckBox Content="Alt" IsChecked="{Binding UseAlt}" Margin="0,0,14,0" />
                    <CheckBox Content="Mayús" IsChecked="{Binding UseShift}" />
                </StackPanel>
            </Grid>
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Tecla del menú:" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Help}" Text="Pulsación corta: abrir el menú del juego, o volver al juego. Pulsación larga: menú de energía." />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <ComboBox Width="80" ItemsSource="{Binding KeyOptions}" SelectedItem="{Binding MenuKey}" />
                </ContentControl>
            </Grid>
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Tecla de finalizar juego:" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Help}" Text="Cierra el juego directamente, sin confirmación." />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <ComboBox Width="80" ItemsSource="{Binding KeyOptions}" SelectedItem="{Binding EndKey}" />
                </ContentControl>
            </Grid>
            </StackPanel>
        </TabItem>
        <TabItem Header="Capturas y clips">
            <StackPanel Margin="4,18,8,20" MaxWidth="640" HorizontalAlignment="Left">
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Programa:" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Help}" Text="Rellena los atajos habituales del programa; corrígelos si los has cambiado en él. Los que dejes vacíos no aparecen en el menú. Formato: Ctrl+Shift+S, Alt+F1, Win+Alt+PrtScn..." />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <ComboBox Width="160" ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding CapturePreset}" />
                </ContentControl>
            </Grid>
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Capturar pantalla:" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <TextBox Width="160" Text="{Binding ScreenshotKeys, UpdateSourceTrigger=PropertyChanged}" />
                </ContentControl>
            </Grid>
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Guardar clip:" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <TextBox Width="160" Text="{Binding ClipKeys, UpdateSourceTrigger=PropertyChanged}" />
                </ContentControl>
            </Grid>
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Ver capturas:" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <TextBox Width="160" Text="{Binding GalleryKeys, UpdateSourceTrigger=PropertyChanged}" />
                </ContentControl>
            </Grid>
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Carpetas extra:" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Help}" Text="Opcional, separadas por punto y coma. El menú ya busca en las carpetas habituales (GameHQ, Captures, Screenshots, NVIDIA...)." />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <TextBox Width="300" Text="{Binding CaptureFolders, UpdateSourceTrigger=PropertyChanged}" />
                </ContentControl>
            </Grid>
            </StackPanel>
        </TabItem>
        <TabItem Header="Juegos">
            <StackPanel Margin="4,18,8,20" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Pausar el juego al abrir el menú" IsChecked="{Binding PauseGame}" />
                <TextBlock Style="{StaticResource Help}" Text="Pausar el juego al abrir el menú: si lo desactivas, el menú se abre encima y el juego sigue en marcha. Los juegos con anticheat nunca se pausan." />
            </StackPanel>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="No abrir el menú en juegos de emulador" IsChecked="{Binding SkipEmulatedGames}" />
                <TextBlock Style="{StaticResource Help}" Text="No abrir el menú en juegos de emulador: el botón Guía lo recibe el emulador (RetroArch, PCSX2, DuckStation...) con su propio menú. Para excluir solo algunos juegos, ponles la etiqueta «Sin overlay» (o «NoOverlay») en Playnite." />
            </StackPanel>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="No pausar juegos con anticheat" IsChecked="{Binding NoPauseAntiCheat}" />
                <TextBlock Style="{StaticResource Help}" Text="EasyAntiCheat, BattlEye, Vanguard, ACE... y los marcados con la etiqueta «No pausar»: el menú se abre con el juego en marcha para no perder la partida online." />
            </StackPanel>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Quitar «Ejecutar como administrador» al iniciar" IsChecked="{Binding AutoRemoveAdmin}" />
                <TextBlock Style="{StaticResource Help}" Text="Quita esa marca de compatibilidad de los juegos antes de iniciarlos, para poder pausarlos sin reiniciar." />
            </StackPanel>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Menú de energía fuera de un juego" IsChecked="{Binding PowerMenuOutsideGame}" />
                <TextBlock Style="{StaticResource Help}" Text="Abre también el menú de energía con el botón o el atajo cuando no hay ningún juego en marcha." />
            </StackPanel>
            <StackPanel Tag="row" Margin="0,0,0,16">
                <CheckBox Style="{StaticResource Switch}" Content="Mantener el juego delante" IsChecked="{Binding KeepGameInFront}" />
                <TextBlock Style="{StaticResource Help}" Text="Si Playnite aparece solo durante el juego (p. ej. al cerrar el overlay de capturas), se minimiza y el juego vuelve al frente." />
            </StackPanel>
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Juegos que se ejecutan como administrador:" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Help}" Text="Windows no deja a un Playnite normal pausar ni cerrar esos juegos. La solución completa: ejecutar Playnite como administrador, o quitar «Ejecutar como administrador» en las propiedades del juego." />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="250" VerticalAlignment="Top" SelectedIndex="{Binding ElevatedMode}">
                    <ComboBoxItem Content="Abrir el menú encima, sin pausar el juego" />
                    <ComboBoxItem Content="Solo avisar en pantalla (no abrir el menú)" />
                </ComboBox>
            </Grid>
            </StackPanel>
        </TabItem>
        <TabItem Header="Avanzado">
            <StackPanel Margin="4,18,8,20" MaxWidth="640" HorizontalAlignment="Left">
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Pulsación larga (ms):" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <TextBox Width="80" Text="{Binding LongPressMs, UpdateSourceTrigger=PropertyChanged}" />
                </ContentControl>
            </Grid>
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Reiniciar:" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Help}" Text="Se ejecutan con cmd. Puedes sustituir el de apagar por un script propio." />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <TextBox Width="260" Text="{Binding RestartCommand}" />
                </ContentControl>
            </Grid>
            <Grid Tag="row" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Apagar:" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Help}" Text="Se ejecutan con cmd. Puedes sustituir el de apagar por un script propio." />
                </StackPanel>
                <ContentControl Grid.Column="1" VerticalAlignment="Top">
                    <TextBox Width="260" Text="{Binding ShutdownCommand}" />
                </ContentControl>
            </Grid>
            </StackPanel>
        </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
